  "formulas": [
    {
      "name": "annual_views",
      "definition": "sum(monthly pageviews) over the last 12 complete months",
      "edge_cases": "null if any of the 12 months is missing"
    },
    {
      "name": "monthly_average",
      "definition": "annual_views / 12",
      "edge_cases": ""
    },
    {
      "name": "daily_average",
      "definition": "annual_views / number of days in those 12 months",
      "edge_cases": ""
    },
    {
      "name": "yoy",
      "definition": "(last 12M / previous 12M) - 1",
      "edge_cases": "null if previous 12M <= 0 or incomplete"
    },
    {
      "name": "three_year_cagr",
      "definition": "(last 12M / the 12M ending 36 months earlier) ** (1/3) - 1",
      "edge_cases": "null if the earlier 12M is incomplete or zero"
    },
    {
      "name": "last_three_month_growth",
      "definition": "(last 3M / previous 3M) - 1",
      "edge_cases": ""
    },
    {
      "name": "previous_three_month_growth",
      "definition": "(previous 3M / the 3M before that) - 1",
      "edge_cases": ""
    },
    {
      "name": "acceleration",
      "definition": "last_three_month_growth - previous_three_month_growth",
      "edge_cases": "momentum: accelerating > +5 pp, decelerating < -5 pp, otherwise stable"
    },
    {
      "name": "period_over_period",
      "definition": "(requested period total / previous equivalent period total) - 1",
      "edge_cases": ""
    },
    {
      "name": "peak_month / trough_month",
      "definition": "calendar month with the highest / lowest mean views across the requested period",
      "edge_cases": ""
    },
    {
      "name": "peak_to_average",
      "definition": "max(calendar-month means) / mean(calendar-month means)",
      "edge_cases": ""
    },
    {
      "name": "trough_to_average",
      "definition": "min(calendar-month means) / mean(calendar-month means)",
      "edge_cases": ""
    },
    {
      "name": "volatility",
      "definition": "pstdev(monthly views) / mean(monthly views) over the requested period",
      "edge_cases": "null with fewer than 3 months"
    },
    {
      "name": "views_per_unique_device",
      "definition": "pageviews / unique devices",
      "edge_cases": "unique devices are published per project only, so this is null for articles"
    },
    {
      "name": "coverage",
      "definition": "months with data / months in the requested period",
      "edge_cases": ""
    },
    {
      "name": "topic_penetration",
      "definition": "topic views / all views of that language edition, both over the last 12 months",
      "edge_cases": "same traffic class (access, agent) for both; 'Wikipedia topic penetration', not market penetration"
    },
    {
      "name": "topic_share",
      "definition": "topic views in one edition / topic views across all compared editions (last 12 months)",
      "edge_cases": "relative to the compared set; editions without data are excluded and listed"
    },
    {
      "name": "topic_affinity",
      "definition": "(topic views / edition views) / (compared topic views / compared edition views)",
      "edge_cases": "location quotient relative to the compared editions; not an official Wikimedia metric"
    },
    {
      "name": "quadrant",
      "definition": "growth: YoY > 0; demand: annual views >= median of compared editions; labels investigate / explore / established / watch are descriptive, not recommendations",
      "edge_cases": ""
    }
  ],
